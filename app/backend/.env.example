# App
APP_ENV=development
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Bybit Demo only
BYBIT_API_KEY=your_demo_api_key_here
BYBIT_API_SECRET=your_demo_api_secret_here
BYBIT_DEMO=true
EXECUTION_ENABLED=true
EXECUTION_SELECTION_MODE=SCANNER
SCANNER_DYNAMIC_LIMIT=7

# Optional Telegram notification integration (status only until notifier is enabled)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AI analyst - read-only, never execution authority
AI_ENABLED=false
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800

# Persistence: leave DATABASE_URL empty for local SQLite. Set it to Neon PostgreSQL in deployment.
DATABASE_URL=
DATABASE_PATH=data/trading_bot.sqlite3
